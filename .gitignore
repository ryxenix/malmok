bin/
out/

# docs/img 에는 README 가 참조하는 것만 둔다.
# scripts/record.sh 로 재생성한다 — 손으로 찍어 넣지 않는다.
docs/img/*
!docs/img/tui-*.gif
!docs/img/malmok-wordmark.png
!docs/img/malmok-mascot-wordmark.png
dist/
site/
internal/tools/payload/

# Bytecode left by the MkDocs hook in scripts/ on every local build.
__pycache__/

# Lab cache TLS material and credentials, generated by
# test/lab/cache/mkmaterial.sh. Never committed: a private key published once
# is a private key nobody can trust again, and the htpasswd file is a
# credential whatever the password is.
test/lab/cache/tls/
test/lab/cache/auth/
